#!/bin/bash
# oc-statusline-wrap — setzt die OC-Zeilen UNTER eine bestehende Statuszeile.
#
# Claude Code erlaubt nur EINEN statusLine-Befehl. Dieser Wrapper ruft den
# bisherigen (OC_STATUSLINE_BASE) mit demselben stdin auf und hängt je
# laufendem Auftrag eine Zeile darunter — die vorhandene Anzeige bleibt
# unverändert. Ohne Aufträge sieht die Statusleiste aus wie vorher.
input=$(cat)
base_out=""
[ -n "${OC_STATUSLINE_BASE:-}" ] && base_out=$(printf '%s' "$input" | $OC_STATUSLINE_BASE 2>/dev/null)
oc_out=$(python3 "$(dirname "$0")/oc-statusline" 2>/dev/null)
if [ -n "$base_out" ] && [ -n "$oc_out" ]; then printf '%s\n%s' "$base_out" "$oc_out"
else printf '%s%s' "$base_out" "$oc_out"; fi
