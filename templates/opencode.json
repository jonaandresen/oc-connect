{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git commit*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git checkout origin/*": "deny",
      "git worktree*": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "docker *": "deny",
      "gh pr merge*": "deny",
      "gh pr create*": "deny",
      "gh issue close*": "deny",
      "gh issue edit*": "deny",
      "gh issue comment*": "deny",
      "npm install*": "deny",
      "sudo *": "deny",
      "rm -rf *": "ask",
      "yarn add*": "deny",
      "pnpm add*": "deny",
      "git clean*": "deny",
      "git branch -D*": "deny",
      "git stash*": "deny"
    },
    "external_directory": "deny"
  }
}
